# Copy to .env.local and set one or more provider keys. Never commit .env.local.
# Alternatively use a personal key through AI settings in the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Optional OpenAI-compatible local or hosted model. The key is optional.
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_API_KEY=

# NVIDIA NIM: select an available model in AI settings or configure its exact ID.
NVIDIA_API_KEY=
NVIDIA_MODEL=
